# Drizzle
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=cuatclub
DATABASE_URL="postgresql://postgres:password@localhost:5432/cuatclub"

# Better Auth
BETTER_AUTH_SECRET=dummy
BETTER_AUTH_URL=http://localhost:3000

## Resend
RESEND_API_KEY=

# Verified sender in Resend (e.g. cuatclub@resend.dev for dev)
EMAIL_FROM=
CALENDAR_CLAIM_SECRET=

# Vercel Cron sends this value as the Bearer token for scheduled jobs.
CRON_SECRET=

# Google Client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# R2
R2_ACCESS_KEY_ID=dummy
R2_SECRET_ACCESS_KEY=dummy
R2_ENDPOINT=dummy
R2_BUCKET=dummy
# Public URL for bucket (enable Public access in R2; use r2.dev URL or custom domain subdomain)
R2_PUBLIC_BASE_URL=https://pub-dummy.r2.dev
